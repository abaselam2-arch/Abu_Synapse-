
# Copy this file to .env on your backend server.

OPENAI_API_KEY=replace_with_your_private_api_key

# Select a model available in your API project.
OPENAI_MODEL=gpt-5-mini

# Only allow your deployed frontend origin.
# For local testing, you can use http://localhost:3000.
FRONTEND_ORIGIN=http://localhost:3000

PORT=3000
